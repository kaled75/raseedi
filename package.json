{
  "name": "raseedi",
  "productName": "رَصيدي - Raseedi",
  "version": "1.0.1",
  "description": "تطبيق إدارة الديون الشخصية الاحترافي - Professional Personal Debt Manager",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && tsc -p tsconfig.electron.json && electron .",
    "dev": "concurrently -k -p \"[{name}]\" -n \"Vite,Electron\" -c \"cyan,magenta\" \"npm run dev:vite\" \"npm run dev:electron\"",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "electron .",
    "test": "tsx tests/run_tests.ts",
    "dist": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.raseedi.debtmanager",
    "productName": "رَصيدي - Raseedi",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "رَصيدي - Raseedi",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "رَصيدي - Raseedi"
    }
  },
  "keywords": [
    "debt-manager",
    "personal-finance",
    "electron",
    "react",
    "arabic-rtl",
    "raseedi"
  ],
  "author": "خالد الرماح ابورقيقة <kl2009k@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  }
}
